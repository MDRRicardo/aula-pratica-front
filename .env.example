# Qual backend usar?  "local" (Express)  ou  "supabase"
VITE_BACKEND=local

# --- Backend local (Express) ---
VITE_API_URL=http://localhost:3001

# --- Supabase (só se VITE_BACKEND=supabase) ---
# Encontras estes valores em: Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cola-aqui-a-anon-key
